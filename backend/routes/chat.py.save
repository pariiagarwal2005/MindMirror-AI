        "studying",
        "syllabus",
        "assignment",
        "assignments",
        "college",
        "deadline",
        "deadlines",
        "semester",
        "test",
        "tests",
        "revision"
    ]

    if any(word in lower_text for word in exam_words):

        if (
            "scared" in lower_text
            or "afraid" in lower_text
            or "fail" in lower_text
            or "failure" in lower_text
            or "worried" in lower_text
            or "anxious" in lower_text
        ):

            return {
                "reply": (
                    "🫂 It sounds like the pressure is coming from "
                    "having a lot to finish while also worrying that "
                    "there isn't enough time.\n\n"

                    "That can make everything feel impossible before "
                    "you've even started. But being behind right now "
