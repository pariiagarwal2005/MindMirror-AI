    # =========================================================
    # RELATIONSHIP / TRUST
    # =========================================================

    relationship_words = [
        "trust",
        "cheat",
        "cheating",
        "betray",
        "betrayed",
        "lied",
        "lying",
        "lie",
        "relationship",
        "boyfriend",
        "girlfriend",
        "partner",
        "ex"
    ]

    if any(word in lower_text for word in relationship_words):

        return {
            "reply": (
                "🫂 It sounds like this relationship situation is "
                "leaving you with a lot of uncertainty.\n\n"

                "When trust is shaken, it's normal for your mind to "
                "keep replaying things and looking for signs that "
                "something is wrong.\n\n"

                "Try separating the things you actually know from the "
