    # HAPPINESS / PRIDE / RELIEF
    # =========================================================

    positive_words = [
        "happy",
        "excited",
        "proud",
        "relieved",
        "great",
        "amazing",
        "accomplished",
        "success",
        "succeeded",
        "finished",
        "finally",
        "worked",
        "worked!",
