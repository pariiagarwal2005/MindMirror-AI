        "stressed",
        "pressure",
        "deadline",
        "too much",
        "too many things",
        "can't handle",
        "cannot handle"
    ]

    if any(word in lower_text for word in stress_words):

        return {
            "reply": (
                "🌱 It sounds like you've got more on your plate "
